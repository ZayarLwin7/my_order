# Never commit your real .env file.
DATABASE_URL=postgresql://username:password@localhost:5432/my_order
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
ENVIRONMENT=production
ALLOWED_HOSTS=api.example.com
# Leave empty if this backend is not called by a browser on another origin.
ALLOWED_ORIGINS=https://app.example.com
DELIVERY_BASE_FEE_MMK=3500
QUOTE_EXPIRE_MINUTES=30
